  },
  "devDependencies": {
    "@nopass/config": "workspace:*",
    "@types/node": "^20",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=18"
  }
}
