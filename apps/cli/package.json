{
  "name": "@nopass/cli",
  "version": "0.1.0",
  "description": "nopass CLI \u2014 fetch vault secrets for AI agents and scripts",
  "type": "module",
  "bin": {
    "nopwd": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
