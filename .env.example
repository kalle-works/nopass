# Copy to .env and fill in all values before starting the server.

DATABASE_URL=postgres://nopass:nopass_dev_secret@localhost:5440/nopass_dev

# 32+ byte random secret. Generate: openssl rand -base64 32
# The server refuses to start with a value shorter than 32 chars.
NOPASS_SESSION_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_32

NOPASS_HOST=127.0.0.1
NOPASS_PORT=3001

# Comma-separated list of allowed CORS origins.
# In production set to the exact app URL, e.g. https://nopass.app
# Never use "*" — the server enforces this.
NOPASS_ALLOWED_ORIGINS=http://localhost:4020,http://localhost:1420,tauri://localhost

# Comma-separated list of trusted reverse-proxy IPs (used for X-Forwarded-For).
# Leave empty when the API is directly internet-facing (safe default).
# NOPASS_TRUSTED_PROXIES=10.0.0.1
