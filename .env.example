# Copy to .env and fill in values
DATABASE_URL=postgres://nopass:nopass_dev_secret@localhost:5432/nopass_dev

# 32+ byte random secret for session tokens
NOPASS_SESSION_SECRET=change_me_to_32_random_bytes_here

NOPASS_HOST=127.0.0.1
NOPASS_PORT=3001

# Comma-separated list of allowed CORS origins.
# In production set to the exact app URL: https://nopwd.dev
# Never use "*" — the server enforces this at startup.
NOPASS_ALLOWED_ORIGINS=http://localhost:4020

# Optional: TLS cert paths for production
# NOPASS_TLS_CERT=/path/to/cert.pem
# NOPASS_TLS_KEY=/path/to/key.pem
