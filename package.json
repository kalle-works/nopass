{
  "name": "nopass",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter @nopass/web dev",
    "dev:desktop": "pnpm --filter @nopass/desktop tauri dev",
    "dev:extension": "pnpm --filter @nopass/extension dev",
    "build:cli": "pnpm --filter @nopass/cli build",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "@tauri-apps/cli"],
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10",
      "browserslist@<4.28.7": ">=4.28.7",
      "@babel/core@<7.29.6": ">=7.29.6",
      "baseline-browser-mapping@<2.11.0": ">=2.11.0",
      "source-map-js@<1.2.2": ">=1.2.2"
    }
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.4"
}
